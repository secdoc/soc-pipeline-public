# Copy to .env and fill in. NEVER commit the real .env.
# --- SIEM core ---
WAZUH_HOST=<WAZUH_HOST>
WAZUH_API_USER=<WAZUH_API_USER>
WAZUH_API_PASS=<WAZUH_API_PASS>
GRAYLOG_HOST=<GRAYLOG_HOST>
GRAYLOG_GELF_PORT=12201
GRAYLOG_TOKEN=<GRAYLOG_TOKEN>
# --- Vulnerability ---
SCANNER_HOST=<SCANNER_HOST>
GMP_USER=<GMP_USER>
GMP_PASS=<GMP_PASS>
# --- Response / orchestration ---
SHUFFLE_HOST=<SHUFFLE_HOST>
SHUFFLE_API_KEY=<SHUFFLE_API_KEY>
VELOCIRAPTOR_HOST=<VELOCIRAPTOR_HOST>
VELOCIRAPTOR_API_CONFIG=<path-to-api_client.yaml>
# --- DNS ---
DNS_API_HOST=<DNS_HOST>
DNS_API_TOKEN=<DNS_TOKEN>
# --- Optional AI enrichment ---
ANTHROPIC_API_KEY=<API_KEY>
