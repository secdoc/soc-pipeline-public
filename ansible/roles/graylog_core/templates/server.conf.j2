is_leader = {{ graylog_is_leader | bool | lower }}
node_id_file = /etc/graylog/server/node-id
password_secret = {{ graylog_core_password_secret }}
root_password_sha2 = {{ graylog_core_root_password_sha2 }}
bin_dir = /usr/share/graylog-server/bin
data_dir = /var/lib/graylog-server
plugin_dir = /usr/share/graylog-server/plugin
integrations_scripts_dir = /usr/share/graylog-server/scripts
stream_aware_field_types = false
disabled_retention_strategies = none,close
allow_leading_wildcard_searches = false
allow_highlighting = false
field_value_suggestion_mode = on
output_batch_size = 500
output_flush_interval = 1
output_fault_count_threshold = 5
output_fault_penalty_seconds = 30
processor_wait_strategy = blocking
ring_size = 65536
inputbuffer_ring_size = 65536
inputbuffer_wait_strategy = blocking
mongodb_uri = {{ graylog_core_mongodb_uri }}
mongodb_max_connections = 1000
http_bind_address = {{ ansible_host }}:9000
http_publish_uri = https://{{ inventory_hostname }}.example.internal:9000/
http_external_uri = https://{{ inventory_hostname }}.example.internal:9000/
http_enable_tls = true
http_tls_cert_file = /etc/graylog/server/tls/server-chain.pem
http_tls_key_file = /etc/graylog/server/tls/server-key.pem
message_journal_enabled = true
message_journal_dir = /var/lib/graylog-server/journal/data
message_journal_max_age = 72h
message_journal_max_size = 80gb
