{
  "portal": {
    "title": "Cerebro",
    "classification": "Internal",
    "refresh_seconds": 60
  },
  "integrations": [
    {
      "id": "siem-health",
      "name": "SIEM Health",
      "category": "SOC",
      "connector": "json_file",
      "path": "/var/lib/cerebro/snapshots/siem-health.json",
      "collected_at_path": "collected_at",
      "healthy_path": "healthy",
      "summary_paths": {
        "active_findings": "findings",
        "critical_alerts": "critical_alerts",
        "active_hosts": "active_hosts",
        "cluster_health": "cluster.health",
        "backup_state": "backup.state"
      },
      "analytics_paths": {
        "security_activity": "security_activity"
      },
      "record_count_path": "security_activity.event_count",
      "source_owner": "Security Operations",
      "collection_cadence_seconds": 120,
      "max_age_seconds": 600,
      "deep_link": "https://siem.example.com/"
    },
    {
      "id": "vulnerability-scanner",
      "name": "Vulnerability Scanner",
      "category": "Vulnerability",
      "connector": "json_file",
      "path": "/var/lib/cerebro/snapshots/vulnerability-health.json",
      "collected_at_path": "collected_at",
      "healthy_path": "healthy",
      "summary_paths": {
        "total_findings": "total_findings",
        "affected_hosts": "affected_hosts",
        "critical_findings": "severity.critical",
        "high_findings": "severity.high",
        "medium_findings": "severity.medium",
        "low_findings": "severity.low",
        "latest_scan_end": "latest_scan_end"
      },
      "record_count_path": "total_findings",
      "source_owner": "Vulnerability Management",
      "collection_cadence_seconds": 604800,
      "max_age_seconds": 691200,
      "deep_link": "https://scanner.example.com/"
    },
    {
      "id": "soar",
      "name": "SOAR",
      "category": "Response",
      "connector": "static",
      "state": "planned",
      "summary": {"actions": "not exposed", "native_access": "preserved"},
      "max_age_seconds": 600,
      "deep_link": "https://soar.example.com/"
    }
  ]
}
