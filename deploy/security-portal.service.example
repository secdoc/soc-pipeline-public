[Unit]
Description=Security Visibility Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=security-portal
Group=security-portal
WorkingDirectory=/srv/example/security-portal
ExecStart=/usr/bin/python3 -m security_portal.server --config /etc/security-portal/config.json --bind localhost --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/var/lib/security-portal/snapshots
UMask=0077

[Install]
WantedBy=multi-user.target
